{
  "name": "visual-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "check:env": "node scripts/tasks.mjs env",
    "dev": "node scripts/tasks.mjs dev",
    "preview": "node scripts/tasks.mjs preview",
    "build": "node scripts/tasks.mjs build",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:visual": "node scripts/tasks.mjs visual",
    "test:report": "playwright show-report artifacts/browser/report",
    "check": "node scripts/tasks.mjs check",
    "check:agents": "node scripts/tasks.mjs agents",
    "probe:render": "tsx tools/quality-lab/generate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
